# Biohack Tech: every environment variable the app reads.
# Never commit real values. In production set them in the hosting provider's variables panel.
# The app reports what is missing at start (logs), at /api/health and on /admin.

# ─── APP ────────────────────────────────────────────────────────────────
# production | staging | development. production refuses Stripe test keys and the local database.
APP_ENV=production
# Public URL, https, no trailing slash. Used for canonical URLs, sitemap, email links and payment return URLs.
NEXT_PUBLIC_SITE_URL=https://biohack-tech.ro

# ─── DATABASE (PostgreSQL 14+) ──────────────────────────────────────────
# Canonical orders live here. Migrations run automatically on first use (or: npm run db:migrate).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/biohack
# Optional: force TLS / pool size.
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=true   # false only for providers with self-signed certificates
# DATABASE_POOL_MAX=5
# Development only: without DATABASE_URL (and APP_ENV not production) an embedded database is used here.
# LOCAL_DB_DIR=.data/pglite

# ─── STRIPE (card payments) ─────────────────────────────────────────────
# All three are required for "Card bancar" to be offered. Live keys only with APP_ENV=production.
STRIPE_SECRET_KEY=sk_live_...
# Also accepted as NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY.
STRIPE_PUBLISHABLE_KEY=pk_live_...
# From Developers > Webhooks > the endpoint https://biohack-tech.ro/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── BANK TRANSFER ──────────────────────────────────────────────────────
# All three required for "Transfer bancar" to be offered. The IBAN is checksum-validated.
BANK_BENEFICIARY=
BANK_NAME=
BANK_IBAN=
# Optional.
BANK_SWIFT=

# ─── FGO (invoices) ─────────────────────────────────────────────────────
# Without these, paid orders are marked "factură manuală" in /admin.
# Company CUI as registered in FGO (digits, as FGO expects it).
FGO_COD_UNIC=
# FGO > Setări > Utilizatori > utilizator API > Cheie privată
FGO_PRIVATE_KEY=
# FGO > Setări > Serii documente (invoice series used for the online shop)
FGO_SERIE=
# VAT rate included in the prices, e.g. 21. Confirm with the accountant.
FGO_VAT_RATE=
# production | test (test = https://api-testuat.fgo.ro/v1, a separate FGO account)
FGO_ENV=test
# Unit of measure on invoice lines (default BUC).
# FGO_UM=BUC
# Bank transfer orders: invoice when the payment is confirmed (on_payment, default) or by hand (manual).
# FGO_TRANSFER_INVOICE=on_payment
# Cash on delivery orders: invoice when the parcel ships (on_shipment, default), when the courier's
# settlement is recorded (on_collection), or by hand (manual). The invoice is never marked as collected.
# FGO_COD_INVOICE=on_shipment
# Full refunds: also issue the FGO storno automatically (default false: the accountant does it).
# FGO_AUTO_STORNO=false

# ─── GOHIGHLEVEL (CRM + email sending) ──────────────────────────────────
# Sub-account > Settings > Private Integrations. Scopes: see docs/PRODUCTION-LAUNCH.md §10.
GHL_PRIVATE_TOKEN=
# Sub-account (location) id: Settings > Business Profile.
GHL_LOCATION_ID=
# Pipeline "Comenzi Biohack Tech" id (stages are matched by name).
GHL_PIPELINE_ID=

# ─── EMAIL (transactional) ──────────────────────────────────────────────
# smtp = our own mailbox on mail.biohack-tech.ro (production); file = write to EMAIL_FILE_DIR (development);
# ghl = GoHighLevel conversations (sends with the NEUROS sender, do not use in production); none = off.
EMAIL_TRANSPORT=smtp
# The mailbox that sends (contact@biohack-tech.ro). Implicit TLS on 465. Password only in Vercel, never in git.
SMTP_HOST=mail.biohack-tech.ro
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Operational notifications for the team (new orders, overdue steps, refunds to do, failed integrations).
NOTIFY_EMAIL=orders@biohack-tech.ro
# The service email the day after delivery (W6 P1); set to off to stop it.
# DELIVERY_FOLLOWUP=off
# Sender of every email: Biohack Tech <contact@biohack-tech.ro> (a bare address gets the "Biohack Tech" name).
EMAIL_FROM=Biohack Tech <contact@biohack-tech.ro>
# EMAIL_FILE_DIR=.data/emails

# ─── OPERATIONS ─────────────────────────────────────────────────────────
# /admin (HTTP Basic Auth). Password: at least 10 characters. Without it /admin does not exist.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Bearer secret for /api/jobs/run (Vercel Cron sends it as GET; any other scheduler can POST). Required on Vercel.
CRON_SECRET=
# Minutes after which an unpaid card order is marked "Plată nefinalizată" (default 60). Stripe is asked
# first, so a payment whose webhook was lost is confirmed instead of abandoned.
# ABANDON_AFTER_MINUTES=60
# Days after which an unpaid bank-transfer order is cancelled automatically (customer gets the
# cancellation email). Empty = never (default): the team cancels by hand. Business decision, see OPEN-POINTS.
# TRANSFER_EXPIRY_DAYS=
# The in-process job runner (every 60s). Set to off on serverless hosts and use the cron instead.
# JOBS_INTERVAL=on

# ─── COMPANY IDENTIFICATION (legal pages, footer; Legea 365/2002 art. 5) ─
# Public data, read at build time. Defaults are the confirmed company data (src/config/company.ts:
# NEUROS EUROPE S.R.L., CUI 50323873, J2024001256321, Str. N. D. Cocea nr. 10, Sibiu). Set a variable
# only to override it. The IBAN is never here: it is BANK_IBAN.
COMPANY_LEGAL_NAME=
COMPANY_CUI=
COMPANY_REG_COM=
# Registered office, one line.
COMPANY_ADDRESS=
# Where returned products go, if different from the registered office. Not provided yet.
COMPANY_RETURN_ADDRESS=

# ─── ADVERTISING LANDINGS ───────────────────────────────────────────────
# Landings answer on <slug>.<LANDING_BASE_DOMAIN> (calm, focus, amber; brain-flow is retired and redirects to the main site). Only these
# hostnames are recognized; any other Host is the main site. Locally: /lp/<slug> or <slug>.localhost:3000.
# LANDING_BASE_DOMAIN=biohack-tech.ro

# ─── FULFILLMENT ────────────────────────────────────────────────────────
# Courier provider. Only "manual" exists (AWB typed in /admin); no courier API is integrated.
# COURIER_PROVIDER=manual

# ─── COOKIE CONSENT / OPTIONAL TOOLS (docs/PRODUCTION-LAUNCH.md §15) ────
# Each tool loads only after the visitor allows its category. Clarity is configured by default,
# so the cookie banner is shown until the visitor chooses.
# Analytics: Google Analytics 4 measurement id (G-XXXXXXX).
# NEXT_PUBLIC_GA4_ID=
# Microsoft Clarity project id (session recording and heatmaps). Unset uses ok5pjeez4o.
# The official snippet loads once from the root layout (next/script, afterInteractive) only after
# analytics consent, and never on /admin, checkout, order, recovery, unsubscribe, or withdrawal.
# NEXT_PUBLIC_CLARITY_ID=
# Marketing: Meta Pixel. Loads only with META_PIXEL_ENABLED=true (read at BUILD time: change it, then redeploy)
# and, in the browser, only after the visitor accepts marketing cookies. The id defaults to Biohack Tech's
# pixel 967887562483664. NEXT_PUBLIC_META_PIXEL_ID overrides it, except the retired pixel 826932839766824
# (blocked by Meta traffic permissions), which is ignored.
# META_PIXEL_ENABLED=false
# NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API: server Purchase when an order is paid (Stripe webhook, reconcile, or admin). Same event
# id as the browser pixel (the order number), value in lei, currency RON. Absent: nothing is sent, orders still complete.
# META_CAPI_TEST_EVENT_CODE (optional) shows those events under Events Manager → Test Events.
# META_CAPI_ACCESS_TOKEN=
# META_CAPI_TEST_EVENT_CODE=

# ─── CONVERSION ENGINE (checkout leads, recovery) ────────────────────────
# Each switch is independent and off unless exactly "true".
# ABANDONED_CHECKOUT_ENABLED: saves the checkout's contact step as a lead and marks an abandoned checkout.
#   Sends nothing by itself.
# ABANDONED_CHECKOUT_ENABLED=false
# RECOVERY_EMAIL_ENABLED: sends the recovery emails (own SMTP, EMAIL_TRANSPORT=smtp) to abandoned leads that
#   gave marketing consent; stops on order, unsubscribe or withdrawal. Needs ABANDONED_CHECKOUT_ENABLED.
# RECOVERY_EMAIL_ENABLED=false
# Delays of the two recovery emails after the last activity.
# RECOVERY_FIRST_MINUTES=30
# RECOVERY_SECOND_HOURS=24
# Activation test mode: recovery emails only to these addresses (comma-separated); everyone else as if off.
# Remove it to send to every eligible lead.
# RECOVERY_TEST_RECIPIENTS=marioxsrb@gmail.com

# ─── AI CALLING (ElevenLabs agent; see docs/ai-calling/README.md) ───────
# Off by default. Only leads who ticked the separate call box, with a Romanian number, are ever called.
# AI_CALLING_ENABLED=false
# Dry run (the default): attempts are recorded, nobody is called. Only "false" places real calls.
# AI_CALLING_DRY_RUN=true
# AI_CALLING_MAX_ATTEMPTS=2
# AI_CALLING_PROVIDER=elevenlabs
# Quiet time after the last activity before the first call, and hours between a missed call and the next.
# AI_CALLING_FIRST_DELAY_MINUTES=60
# AI_CALLING_RETRY_HOURS=24
# Local calling window and weekdays (1 = Monday ... 7 = Sunday), in AI_CALLING_TIMEZONE.
# AI_CALLING_HOURS=10-19
# AI_CALLING_DAYS=1-5
# AI_CALLING_TIMEZONE=Europe/Bucharest
# Controlled testing: only these numbers (E.164, comma-separated) can be called.
# AI_CALLING_TEST_NUMBERS=+407xxxxxxxx
# ElevenLabs: API key, the agent (scripts/elevenlabs-agent.mjs push), the imported Twilio/SIP number, and the
# post-call webhook secret (webhook URL: https://biohack-tech.ro/api/webhooks/elevenlabs).
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=
# ELEVENLABS_PHONE_NUMBER_ID=
# ELEVENLABS_WEBHOOK_SECRET=
# ELEVENLABS_VOICE_ID=          (used by the setup script only)

# ─── MARKETING CONSENT SYNC FROM GHL (optional) ─────────────────────────
# Shared secret for POST /api/ghl/unsubscribe (header x-bt-webhook-secret), called by a GHL workflow
# when a contact opts out inside GHL. Without it the endpoint does not exist. 32+ random characters.
# GHL_WEBHOOK_SECRET=

# ─── TESTING ONLY (never in production) ─────────────────────────────────
# STRIPE_API_BASE / FGO_API_BASE / GHL_API_BASE point the integrations at local mocks.
# TEST_DATABASE_URL=postgres://localhost/biohack_test   # runs the PostgreSQL concurrency tests

# ─── CASH ON DELIVERY (ramburs) ─────────────────────────────────────────
# On by default (needs only the database). false turns it off on the product pages, checkout and server.
# NEXT_PUBLIC_COD_ENABLED=true
# No order-value ceiling: every product and total can be paid on delivery (business decision, 13 Oct 2026).
