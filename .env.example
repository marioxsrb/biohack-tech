# Public URL of the site, used for canonical URLs, sitemap, Open Graph and payment return URLs.
NEXT_PUBLIC_SITE_URL=https://biohack-tech.ro

# ---- Card payments (Stripe Checkout) ----
# sk_test_... or sk_live_... Without it, card payment shows as "în curând".
STRIPE_SECRET_KEY=

# ---- Bank transfer ----
# All three required (plus ORDER_WEBHOOK_URL below), otherwise bank transfer shows as "în curând".
# The IBAN is checksum-validated; an invalid value keeps bank transfer off.
BANK_BENEFICIARY=
BANK_NAME=
BANK_IBAN=
# Optional.
BANK_SWIFT=

# ---- Order notifications ----
# Bank-transfer orders are POSTed here as JSON (status "awaiting_payment").
ORDER_WEBHOOK_URL=
# Optional: sent as "Authorization: Bearer <secret>".
ORDER_WEBHOOK_SECRET=
